{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist/runtime",
    "rootDir": "runtime/src",
    "types": ["node"]
  },
  "include": ["runtime/src/**/*.ts"]
}
