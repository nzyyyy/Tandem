{
  "name": "tandem",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.22.2",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.desktop.json --noEmit && tsc -p tsconfig.renderer.json",
    "format": "prettier --write \"{renderer,desktop,runtime,shared,scripts}/**/*.{ts,tsx,cts,mjs}\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"{renderer,desktop,runtime,shared,scripts}/**/*.{ts,tsx,cts,mjs}\" \"*.{ts,json}\"",
    "test": "node --test runtime/test/*.test.ts desktop/test/*.test.ts shared/test/*.test.ts && vitest run && node scripts/smoke.mjs",
    "dev": "node scripts/launch.mjs",
    "test:lifecycle": "pnpm run build && node scripts/lifecycle.mjs",
    "test:bundle": "node scripts/smoke.mjs --bundled",
    "test:unit": "node --test runtime/test/*.test.ts desktop/test/*.test.ts shared/test/*.test.ts && vitest run",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "koffi": "3.3.8",
    "lucide-react": "1.73.0",
    "plist": "3.1.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1"
  },
  "main": "dist/app/desktop/main.js"
}
